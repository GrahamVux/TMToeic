# --- Server ---
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed web origins (CORS, credentials enabled)
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Supabase PostgreSQL connection string (use the pooler/"transaction" string for serverless, direct for long-running API).
# Leave EMPTY in local dev to use an embedded PGlite (real Postgres in-process) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Defaults: true for PGlite, false for DATABASE_URL (run `npm run db:migrate` in deploy pipeline)
# AUTO_MIGRATE=true

# --- Auth ---
# REQUIRED in production: at least 32 random chars (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_ACCESS_SECRET=
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
# lax (same-site, e.g. Vite proxy or same parent domain) | none (cross-site web+api; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# First admin (created only when no ADMIN exists). Must change password at first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
STUDENT_CODE_PREFIX=TM

# --- Object storage (Cloudflare R2, private bucket; audio/PDF/images) ---
# Account API token with "Object Read & Write" limited to the bucket. Leave all four empty to disable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Rate limiting ---
LOGIN_RATE_LIMIT=10
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
