{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @toeic/shared && npm run build -w @toeic/web",
  "outputDirectory": "apps/web/dist",
  "ignoreCommand": "node -e \"const b=process.env.VERCEL_GIT_COMMIT_REF; process.exit(!b || b==='dev-version' ? 1 : 0)\"",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
